# Variables de entorno para el paso 8 de la tarea 3.
#
# Se usan así:
#   docker run --rm -p 3000:3000 --env-file .env --name midu-web midu-web
#
# Este archivo está en el .dockerignore a propósito: NO se copia
# dentro de la imagen. Las variables se le pasan al contenedor en el
# momento de ejecutarlo.
#
# Regla de oro: un .env real con contraseñas NUNCA se sube a git.
# Este es de ejemplo y no tiene nada sensible.
SALUDO=Hola desde .env
PORT=3000
